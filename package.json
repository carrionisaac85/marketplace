{
  "name": "wantboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "capacitor-assets generate --iconBackgroundColor '#F7F5F2' --iconBackgroundColorDark '#1A1A1A' --splashBackgroundColor '#F7F5F2' --splashBackgroundColorDark '#1A1A1A'",
    "icons:ios": "capacitor-assets generate --ios --iconBackgroundColor '#F7F5F2' --iconBackgroundColorDark '#1A1A1A' --splashBackgroundColor '#F7F5F2' --splashBackgroundColorDark '#1A1A1A'",
    "icons:android": "capacitor-assets generate --android --iconBackgroundColor '#F7F5F2' --iconBackgroundColorDark '#1A1A1A' --splashBackgroundColor '#F7F5F2' --splashBackgroundColorDark '#1A1A1A'",
    "ios:setup": "npx cap add ios && npx cap sync ios",
    "ios:sync": "npx cap sync ios",
    "deploy:rules": "firebase deploy --only firestore:rules,storage --token \"$FIREBASE_TOKEN\"",
    "deploy:functions": "firebase deploy --only functions --token \"$FIREBASE_TOKEN\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.0.0",
    "@capacitor-firebase/messaging": "^7.5.0",
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/cli": "^7.6.5",
    "@capacitor/core": "^7.6.5",
    "@capacitor/ios": "^7.6.5",
    "@capawesome/capacitor-badge": "^7.0.1",
    "firebase": "^10.14.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-react": "^4.0.0",
    "firebase-tools": "^15.18.0",
    "vite": "^4.3.0"
  }
}
