rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email == "carrion.isaac85@gmail.com";
    }

    // ── wants ─────────────────────────────────────────────────────────────
    match /wants/{wantId} {
      allow read: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (
          // Non-owners may only append a new offer to an active (unsold) want.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offers'])
          && request.resource.data.userId == resource.data.userId
          && resource.data.get('status', 'active') != 'sold'
          && request.resource.data.offers.size() == resource.data.get('offers', []).size() + 1
        )
      );

      // Owner or admin may delete
      allow delete: if isAuth()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAuth() && (request.auth.uid == uid || isAdmin());

      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow delete: if isAuth() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ── conversations ─────────────────────────────────────────────────────
    // TEMPORARILY WIDE OPEN for debugging — will tighten back after chat works
    match /conversations/{convoId} {
      allow read, create, update, delete: if isAuth();
      match /messages/{msgId} {
        allow read, create, update, delete: if isAuth();
      }
    }

    // ── config ────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── fcmTokens ─────────────────────────────────────────────────────────
    match /fcmTokens/{uid} {
      allow create, update, delete: if isAuth() && request.auth.uid == uid;
      allow read: if false;
    }

    // ── catch-all: deny everything not matched above ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
