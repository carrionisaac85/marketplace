rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && request.auth.token.email == "carrion.isaac85@gmail.com";
    }

    // ── wants ─────────────────────────────────────────────────────────────
    match /wants/{wantId} {
      allow read: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (
          // Non-owners may only append a new offer to an active (unsold) want.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offers'])
          && request.resource.data.userId == resource.data.userId
          && resource.data.get('status', 'active') != 'sold'
          && request.resource.data.offers.size() == resource.data.get('offers', []).size() + 1
        )
      );

      // Owner or admin may delete
      allow delete: if isAuth()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAuth() && (request.auth.uid == uid || isAdmin());

      match /reviews/{reviewId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow delete: if isAuth() && (request.auth.uid == uid || isAdmin());
      }
    }

    // ── conversations ─────────────────────────────────────────────────────
    match /conversations/{convoId} {
      function isParticipant() {
        return isAuth() && request.auth.uid in resource.data.participants;
      }

      function willBeParticipant() {
        return isAuth() && request.auth.uid in request.resource.data.participants;
      }

      // Any auth user can read (needed to check existence before creating).
      // Content is protected by hard-to-guess convo IDs; messages subcollection has tighter rules.
      allow read: if isAuth();
      allow create: if willBeParticipant() || isAdmin();
      allow update: if isParticipant() || isAdmin();
      // needed so create rules on nested messages can call get() on this doc
      allow delete: if isParticipant() || isAdmin();

      match /messages/{msgId} {
        // Single-document reads: fall back to parent convo for legacy msgs without participants
        allow get: if isAuth() && (
          request.auth.uid in resource.data.participants
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
        );
        // Collection queries: must rely only on document data (no get() allowed in list rules)
        allow list: if isAuth() && request.auth.uid in resource.data.participants;
        // New messages must carry participants (no get needed)
        allow create: if isAuth()
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participants.size() >= 2;
        allow delete: if isAuth() && (
          request.auth.uid in resource.data.participants
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          || isAdmin()
        );
      }
    }

    // ── config ────────────────────────────────────────────────────────────
    match /config/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── fcmTokens ─────────────────────────────────────────────────────────
    match /fcmTokens/{uid} {
      allow create, update, delete: if isAuth() && request.auth.uid == uid;
      allow read: if false;
    }

    // ── catch-all: deny everything not matched above ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
