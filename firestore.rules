rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // ── wants ─────────────────────────────────────────────────────────────
    // A want is owned by the user whose uid matches wants/{wantId}.userId.
    match /wants/{wantId} {
      allow read: if isAuth();

      // Creator must set userId to their own uid; no other ownership is allowed
      allow create: if isAuth()
                    && request.resource.data.userId == request.auth.uid;

      // Two cases:
      //   1. Owner: may update any field on their own want
      //   2. Non-owner: may ONLY modify the `offers` array (to add or strip
      //      their own offer), and MUST NOT change any ownership field.
      //      This prevents the takeover attack where an attacker changes
      //      userId to themselves and then deletes the want.
      allow update: if isAuth() && (
        resource.data.userId == request.auth.uid
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offers'])
          && request.resource.data.userId == resource.data.userId
        )
      );

      // Only the want's owner may delete it
      allow delete: if isAuth()
                    && resource.data.userId == request.auth.uid;
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();

      // A user can only create or update their own profile document
      allow create, update: if isAuth() && request.auth.uid == uid;

      // A user can only delete their own profile document (account deletion)
      allow delete: if isAuth() && request.auth.uid == uid;

      // ── reviews subcollection ─────────────────────────────────────────
      match /reviews/{reviewId} {
        allow read: if isAuth();

        // Any authenticated user can leave a review on another user's profile
        allow create: if isAuth();

        // Only the profile owner can delete reviews during account cleanup;
        // reviewers cannot delete reviews they left on other profiles.
        allow delete: if isAuth() && request.auth.uid == uid;
      }
    }

    // ── conversations ─────────────────────────────────────────────────────
    match /conversations/{convoId} {
      function isParticipant() {
        return isAuth() && request.auth.uid in resource.data.participants;
      }

      function willBeParticipant() {
        return isAuth() && request.auth.uid in request.resource.data.participants;
      }

      // Only participants may read a conversation
      allow read: if isParticipant();

      // Creator must include themselves as a participant
      allow create: if willBeParticipant();

      // Only existing participants may update (e.g. send a message,
      // update lastMessage/updatedAt fields)
      allow update: if isParticipant();

      // Only a participant may delete the conversation (account deletion flow)
      allow delete: if isParticipant();

      // ── messages subcollection ────────────────────────────────────────
      match /messages/{msgId} {
        function isConvoParticipant() {
          return isAuth() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        }

        allow read: if isConvoParticipant();

        // Must be a participant to send a message
        allow create: if isConvoParticipant();

        // A participant can delete any message in the conversation.
        // This covers both in-chat message deletion and the account
        // deletion flow that wipes all messages from the user's convos.
        allow delete: if isConvoParticipant();
      }
    }

    // ── config ────────────────────────────────────────────────────────────
    // config/banned and similar admin documents.
    // Any authenticated user can read (to check the banned-uid list).
    // The admin UI writes these directly from the client, gated by an
    // email check in the app. Full admin-only enforcement requires Firebase
    // Auth custom claims (see follow-up task #15). Deletes are denied for all.
    match /config/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if false;
    }

    // ── reports ───────────────────────────────────────────────────────────
    // Any user can file a report. The admin UI resolves reports by setting
    // resolved:true on the document. No one deletes reports.
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update: if isAuth();
      allow delete: if false;
    }

    // ── catch-all: deny everything not matched above ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
